#!/bin/sh
set -e
export PYTHONDONTWRITEBYTECODE=1
self=$0
while [ -h "$self" ]; do
  dir=$(cd "$(dirname "$self")" && pwd -P)
  self=$(readlink "$self")
  case $self in /*) ;; *) self=$dir/$self ;; esac
done
root=$(cd "$(dirname "$self")/.." && pwd -P)
# The recorder needs Node 20+ and the default node on PATH is often older: the newest nvm 2x (version order) wins, else PATH's node.
NODE_BIN=$(ls -d "$HOME"/.nvm/versions/node/v2[0-9]*/bin 2>/dev/null | sort -V | tail -1)
[ -n "$NODE_BIN" ] && PATH="$NODE_BIN:$PATH"
exec node "$root/skills/explainer-video/scripts/record.mjs" "$@"
