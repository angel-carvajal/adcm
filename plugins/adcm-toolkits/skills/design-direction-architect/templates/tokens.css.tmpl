/* tokens.css · {{PROJECT_NAME}} · {{DATE}}
 * Normally written by `design-board adopt`; packs made before 0.18.0 must be regenerated (the unprefixed color names are gone).
 * Single source of truth. brief.md describes; it does not redefine. Brand constraints override extracted reference values.
 */

/* ============================================================
 * Contract names only. With a design system (Brand status locked or
 * partial), each value is `var(--<ds-token>)` from {{DS_PATH}}, never a
 * restated literal; propose missing tokens as a PR to the DS.
 * ============================================================ */

:root {
  /* — Type — */
  --font-display: {{DISPLAY_STACK}};
  --font-body:    {{BODY_STACK}};
  --font-mono:    {{MONO_STACK}};

  --step--1: {{SIZE_SM}};
  --step-0:  {{SIZE_BASE}};
  --step-1:  {{SIZE_LG}};
  --step-2:  {{SIZE_XL}};
  --step-3:  {{SIZE_2XL}};
  --step-4:  {{SIZE_3XL}};
  --step-5:  {{SIZE_DISPLAY}};

  --leading-tight:    {{LEADING_TIGHT}};
  --leading-body:     {{LEADING_BODY}};
  --tracking-display: {{TRACKING_DISPLAY}};

  /* — Color — */
  --color-ground:     {{GROUND}};
  --color-surface:    {{SURFACE}};
  --color-ink:        {{INK}};          /* contrast on ground: {{RATIO_INK}} */
  --color-ink-muted:  {{INK_MUTED}};    /* contrast on ground: {{RATIO_MUTED}} */
  --color-primary:    {{PRIMARY}};      /* contrast on ground: {{RATIO_PRIMARY}} */
  --color-accent:     {{ACCENT}};       /* contrast on ground: {{RATIO_ACCENT}} */
  --color-accent-ink: {{ACCENT_INK}};   /* text on accent: {{RATIO_ON_ACCENT}} */
  --color-border:     {{BORDER}};

  /* — Spacing (base {{BASE_UNIT}}) — */
  --space-1: {{SP1}};
  --space-2: {{SP2}};
  --space-3: {{SP3}};
  --space-4: {{SP4}};
  --space-5: {{SP5}};
  --space-6: {{SP6}};

  /* — Shape — */
  --radius: {{RADIUS}};

  /* — Motion (budget: {{MOTION_BUDGET}}) — */
  --dur:  {{DUR}};
  --ease: {{EASE}};
}

{{DARK_BLOCK}}
/* If both themes are in scope, redefine ONLY the color tokens here:
 * @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) { … } }
 * :root[data-theme="dark"] { … }
 */

@media (prefers-reduced-motion: reduce) {
  :root { --dur: 0ms; }
}
