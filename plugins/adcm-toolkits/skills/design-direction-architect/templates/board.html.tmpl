function sizeViewer(w) {
VW.w=w;
$$('#vw-size button').forEach(b=>b.setAttribute('aria-pressed',+b.dataset.w===w));
const o=VW.o, stage=$('#vw-stage'), fr=$('#vw-frame'), img=$('#vw-shot'), note=$('#vw-note');
const sw=stage.clientWidth,sh=stage.clientHeight,s=Math.min(1,sw / w),left=Math.max(0,(sw - w * s) / 2);
const shot=o.shot&&(w===390?o.shot.m||o.shot.d:o.shot.d||o.shot.m);
img.hidden=!shot;if (shot) img.src=shot.l;
Object.assign(img.style, {left: left+'px', width: w * s+'px', height: sh+'px'});
