/* ---------- Tokens ---------- */
const fcss=(id,fb)=>(fontById[id]&&fontById[id].css)||fb;
function current() {
const o=optById[S.o];if (!o) return null;
const pair=(o.pairs||[]).find(p=>p.id===S.f)||(o.pairs||[])[0]||null;
const pal=(o.palettes||[]).find(p=>p.id===S.p)||(o.palettes||[])[0]||null;
const colors=Object.assign({},pal?pal.colors:{},S.c);
return {o,pair,pal,colors,edited: Object.keys(S.c).length > 0};
}
function computeVars(cur) {
const {o,pair,colors}=cur,st=o.statics||{},v={};
v['--font-display']=fcss(pair&&pair.display, 'system-ui, sans-serif');
v['--font-body']=fcss(pair&&pair.body, 'system-ui, sans-serif');
v['--font-mono']=fcss(pair&&pair.mono,D.mono);
for (let n=-1;n <= 5;n++) v[n < 0?'--step--1' : '--step-'+n]=fmt(S.b * Math.pow(S.r, n) / 16)+'rem';
for (const k of ['--leading-tight', '--leading-body', '--tracking-display']) v[k]=st[k];
for (const r of ROLES) if (colors[r]) v['--color-'+r]=colors[r].toUpperCase();
for (const [k,val] of Object.entries(st)) if (!/^--(leading|tracking)/.test(k)) v[k]=val;
return v;
}
function fontsHref(pair) {
const fams=[...new Set([pair&&pair.display,pair&&pair.body,pair&&pair.mono].map(id=>fontById[id]&&fontById[id].google).filter(Boolean))];
return fams.length?'https://fonts.googleapis.com/css2?'+fams.map(g=>'family='+g.replace(/ /g, '+')).join('&')+'&display=swap' : '';
}
function applyVars(frame,optId) {
if (optId!==S.o||!frame.closest('#tab-tokens')) return;
const cur=current();if (!cur) return;
const vars=computeVars(cur),href=fontsHref(cur.pair);
try {
const doc=frame.contentDocument;
if (!doc||!doc.documentElement) throw new Error('no access');
for (const [k,v] of Object.entries(vars)) doc.documentElement.style.setProperty(k,v);
if (href) {
let l=doc.querySelector('link[data-board-font]');
if (!l) { l=doc.createElement('link'); l.rel='stylesheet'; l.setAttribute('data-board-font', ''); doc.head.appendChild(l); }
if (l.href!==href) l.href=href;
}
} catch (e) {
if (frame.contentWindow) frame.contentWindow.postMessage({type: 'board-tokens', vars, fonts: href}, '*');
}
}
function comboCode(cur) {
return cur.pair&&cur.pal?`${cur.o.id}/${cur.pair.id}/r${fmt(S.r)}${S.b!==cur.o.base?'b'+fmt(S.b):''}/${cur.pal.id}`:'—';
}
function cssText(cur,vars) {
return `/* tokens.css · ${D.project.name} · ${comboCode(cur)}\n * Exported from the design board; design-board adopt writes the same variables. */\n:root {\n` +
Object.entries(vars).map(([k,v])=>`  ${k}: ${v};`).join('\n')+'\n}\n\n@media (prefers-reduced-motion: reduce) {\n  :root { --dur: 0ms; }\n}\n';
}
function jsonText(cur,vars) {
const p=cur.pair||{};
return JSON.stringify({schema: 1,combo: comboCode(cur),option: cur.o.id,pair: p.id||null,
fonts: {display: p.display||null,body: p.body||null,mono: p.mono||null},scale: {base: S.b,ratio: S.r},
palette: cur.edited ? 'custom' : (cur.pal ? cur.pal.id : null), colors: Object.fromEntries(ROLES.map(r => [r, (cur.colors[r] || '').toUpperCase()])), vars}, null, 2) + '\n';
}
let tkBuilt=null;
function renderTokens() {
