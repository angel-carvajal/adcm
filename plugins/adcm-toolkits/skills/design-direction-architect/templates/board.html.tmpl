el.innerHTML=`<div class="toolbar"><div class="seg" role="group" id="tk-opt">${D.options.map(x=>`<button type="button" data-o="${esc(x.id)}" aria-pressed="${x.id===o.id}">${T.option} ${esc(x.id.toUpperCase())}</button>`).join('')}</div>
<div class="seg" role="group" id="tk-size"><button type="button" data-w="390">390</button><button type="button" data-w="1440" aria-pressed="true">1440</button></div></div>
${(o.pairs||[]).length&&(o.palettes||[]).length?'':`<p class="notice">${T.noTokens}</p>`}
<div class="tk"><div class="panelbox">
<label class="field"><span class="h">${T.pair}</span><select id="tk-pair">${(o.pairs||[]).map(p=>`<option value="${esc(p.id)}">${esc(p.id)} · ${esc((fontById[p.display]||{}).family||p.display)} / ${esc((fontById[p.body]||{}).family||p.body)}</option>`).join('')}</select></label>
<label class="field"><span class="h">${T.base}<output id="tk-bo"></output></span><input type="range" id="tk-base" min="14" max="20" step="0.5"></label>
<label class="field"><span class="h">${T.ratio}<output id="tk-ro"></output></span><input type="range" id="tk-ratio" min="1.067" max="1.618" step="0.001"></label>
<div class="chips" id="tk-rq" style="margin:-6px 0 16px">${ratios.map(r=>`<button class="chip" type="button" data-r="${r}">${fmt(r)}</button>`).join('')}</div>
<label class="field"><span class="h">${T.palette}</span><select id="tk-pal">${(o.palettes||[]).map(p=>`<option value="${esc(p.id)}">${esc(p.id)} · ${esc(p.label)}</option>`).join('')}</select></label>
<div class="field"><span class="h">${T.colors}</span><div class="roles">${ROLES.map(r=>`<label class="role"><input type="color" data-role="${r}" aria-label="${r}"><span>${r}<code></code></span></label>`).join('')}</div></div>
<button class="btn" type="button" id="tk-reset">${T.reset}</button>
</div><div>
<div class="frame tk-frame" id="tk-frame" data-w="1440">${o.variant?`<iframe src="${esc(o.variant)}" title="${esc(T.option+' '+o.id.toUpperCase())}" tabindex="-1" data-opt="${esc(o.id)}"></iframe>`:`<div class="empty">${T.noVariant}</div>`}</div>
<div class="spec" id="tk-spec"></div>
</div></div>
<section class="panelbox export"><div class="combo"><span>${T.code}</span><code id="tk-combo"></code><button class="btn" type="button" id="tk-cc">${T.copy}</button></div>
<div class="actions"><button class="btn primary" type="button" id="tk-dc">${T.dlCss}</button><button class="btn" type="button" id="tk-dj">${T.dlJson}</button><button class="btn" type="button" id="tk-cp">${T.copyCss}</button></div>
<p class="status" id="tk-status" aria-live="polite"></p><pre id="tk-css"></pre></section>`;
const fr=$('#tk-frame');ro.observe(fr);
const ifr=$('iframe',fr);if (ifr) liveFrame(ifr);
bindTokens();
}
syncTokens();
}
function syncTokens() {
const cur=current();if (!cur) return;
$('#tk-pair').value=cur.pair?cur.pair.id : '';
$('#tk-pal').value=cur.pal?cur.pal.id : '';
$('#tk-base').value=S.b; $('#tk-bo').textContent=S.b+'px';
$('#tk-ratio').value=S.r; $('#tk-ro').textContent=fmt(S.r);
$$('#tk-rq .chip').forEach(c=>c.setAttribute('aria-pressed',Math.abs(+c.dataset.r - S.r) < 1e-6));
$$('.role input').forEach(i=>{ const v=cur.colors[i.dataset.role]||'#000000'; i.value=v.toLowerCase(); i.nextElementSibling.querySelector('code').textContent=v.toUpperCase(); });
const vars=computeVars(cur);
$('#tk-spec').innerHTML=[5, 4, 3, 2, 1, 0, -1].map(n=>{ const k=n < 0?'--step--1' : '--step-'+n; return `<div><code>${k.slice(2)}</code><span style="font-family:${esc(vars[n > 1?'--font-display' : '--font-body'])};font-size:${esc(vars[k])};line-height:1.15">${esc(D.project.name)}</span></div>`; }).join('');
$('#tk-combo').textContent=comboCode(cur);
$('#tk-css').textContent=cssText(cur,vars);
$('#tk-status').textContent=cur.edited?T.edited.replace('{id}', cur.o.id) : '';
const f=$('#tk-frame iframe');if (f) applyVars(f,cur.o.id);
loadFonts(cur.pair);
writeHash();
}
function download(name,text,type) {
const url=URL.createObjectURL(new Blob([text],{type}));
const a=Object.assign(document.createElement('a'),{href: url,download: name});
document.body.appendChild(a);a.click();a.remove();
setTimeout(()=>URL.revokeObjectURL(url),1000);
}
function copy(text) {
const st=$('#tk-status');
const done=ok=>{ st.textContent=ok?T.copied:T.copyFail;};
if (navigator.clipboard&&navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(()=>done(true),()=>done(false));
else done(false);
}
function bindTokens() {
$('#tk-opt').onclick=e=>{ const b=e.target.closest('button');if (b&&b.dataset.o!==S.o) { S.o=b.dataset.o;resetTokens();renderTokens();} };
$('#tk-size').onclick=e=>{
const b=e.target.closest('button');if (!b) return;
$$('#tk-size button').forEach(x=>x.setAttribute('aria-pressed',x===b));
const fr=$('#tk-frame'); fr.dataset.w=b.dataset.w; fr.classList.toggle('phone', b.dataset.w==='390');
fr.style.setProperty('--s',fr.clientWidth / +b.dataset.w);
};
$('#tk-pair').onchange=e=>{ S.f=e.target.value;syncTokens();};
$('#tk-pal').onchange=e=>{ S.p=e.target.value;S.c={};syncTokens();};
$('#tk-base').oninput=e=>{ S.b=+e.target.value;syncTokens();};
$('#tk-ratio').oninput=e=>{ S.r=Math.round(+e.target.value * 1000) / 1000;syncTokens();};
$('#tk-rq').onclick=e=>{ const b=e.target.closest('[data-r]');if (b) { S.r=+b.dataset.r;syncTokens();} };
$$('.role input').forEach(i=>{ i.oninput=()=>{ S.c[i.dataset.role]=i.value.toUpperCase();syncTokens();};});
$('#tk-reset').onclick=()=>{ resetTokens();syncTokens();};
$('#tk-cc').onclick=()=>copy($('#tk-combo').textContent);
$('#tk-cp').onclick=()=>copy($('#tk-css').textContent);
$('#tk-dc').onclick=()=>download(`tokens-${S.o}.css`, $('#tk-css').textContent, 'text/css');
$('#tk-dj').onclick=()=>{ const cur=current(); download(`tokens-${S.o}.json`, jsonText(cur, computeVars(cur)), 'application/json'); };
}

/* ---------- fonts: load on demand,report the ones that fail ---------- */
const fontState={};
function loadFonts(pair) {
const ids=pair?[pair.display,pair.body,pair.mono]:D.fonts.map(f=>f.id);
ids.filter(id=>fontById[id]&&fontById[id].google&&!(id in fontState)).forEach(id=>{
const fam=fontById[id].family,spec=`16px "${fam}"`;
fontState[id]='loading';
if (!document.fonts||!document.fonts.load) return;
document.fonts.load(spec).then(list=>{ fontState[id]=list.length&&document.fonts.check(spec)?'ok' : 'missing'; }, ()=>{ fontState[id]='missing'; })
.then(()=>{
const miss=Object.keys(fontState).filter(k=>fontState[k]==='missing').map(k=>fontById[k].family);
const n=$('#b-fonts'); n.hidden=!miss.length; n.textContent=miss.length?T.fontsMissing+miss.join(', ') : '';
});
});
}

/* ---------- global clicks ---------- */
document.addEventListener('click',e=>{
const t=e.target.closest('[data-view],[data-tokens],[data-method],[data-lb],[data-mk],[data-ref],[data-flt]');
if (!t||t.closest('dialog')&&!t.matches('[data-ref]')) return;
if (t.dataset.view) openViewer(t.dataset.view,t);
else if (t.dataset.tokens) { if (S.o!==t.dataset.tokens) { S.o=t.dataset.tokens;resetTokens();} show('tokens');}
else if (t.dataset.method) { show('method'); const m=$('#m-'+CSS.escape(t.dataset.method)); if (m) m.scrollIntoView({behavior: 'smooth', block: 'start'}); }
else if (t.dataset.lb != null) openLb(refList(),+t.dataset.lb,t);
else if (t.dataset.mk != null) openLb(D.market,+t.dataset.mk,t);
else if (t.dataset.ref) { const i=D.refs.findIndex(r=>r.id===t.dataset.ref);if (i >= 0) openLb(D.refs,i,t);}
else if (t.dataset.flt) { S.v=t.dataset.flt;renderRefs();writeHash();}
});

readHash();
renderOptions();renderRefs();renderMarket();renderMethod();
show(S.t);
loadFonts(null);
})();
</script>
</body>
</html>
