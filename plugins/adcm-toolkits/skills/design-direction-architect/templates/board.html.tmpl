<!--
board.html template, rendered by scripts/design-board.py build (this comment is dropped).
Placeholders {{lang}} {{title}} {{fonts_link}} {{tabs}} {{data_json}}; the script renders every tab from #board-data.
Each nav button's data-tab and its panel's id="tab-<value>" must match. Assets are sibling files with ?v=<sha8>.
-->
<!doctype html>
<html lang="{{lang}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{{title}}</title>
<script>document.documentElement.dataset.theme=matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'</script>
{{fonts_link}}
<style>
:root{--bg:#F6F6F3;--surface:#FFFFFF;--raised:#EFEFEA;--text:#18181B;--muted:#686872;--border:#E2E2DC;
--border-strong:#C9C9C1;--primary:#3F48CC;--primary-ink:#FFFFFF;--ok:#18794E;--ok-bg:#E6F4EC;--bad:#B42318;
--bad-bg:#FDECEA;--warn:#93600B;--warn-bg:#FDF3DC;--shadow:0 1px 2px rgba(20,20,30,.06),0 8px 24px rgba(20,20,30,.06);
--r:14px;--ui:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;--mono:ui-monospace,SFMono-Regular,Menlo,monospace}
:root[data-theme="dark"]{--bg:#101012;--surface:#18181C;--raised:#212126;--text:#ECECEF;--muted:#9C9CA6;
--border:#2C2C33;--border-strong:#3C3C45;--primary:#8F96FF;--primary-ink:#101012;--ok:#5BD69A;--ok-bg:#16301F;
--bad:#FF8A80;--bad-bg:#3A1A18;--warn:#F2C46B;--warn-bg:#352B14;--shadow:0 1px 2px rgba(0,0,0,.4),0 8px 24px rgba(0,0,0,.3)}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--text);font:15px/1.55 var(--ui);-webkit-font-smoothing:antialiased}
a{color:var(--primary);text-underline-offset:2px}
button{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--primary);outline-offset:2px}
h1,h2,h3{line-height:1.2;margin:0}
code,pre{font-family:var(--mono)}
.wrap{max-width:1240px;margin:0 auto;padding:0 16px}
header.top{padding:28px 0 18px}
.top .wrap{display:flex;gap:16px;align-items:flex-start;justify-content:space-between}
.top .wrap>div{min-width:0}
.meta .pill{max-width:100%;overflow:hidden;text-overflow:ellipsis;display:inline-block}
.top h1{font-size:clamp(22px,3.4vw,32px);letter-spacing:-.02em}
.top p{margin:6px 0 0;color:var(--muted);max-width:62ch}
.meta{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}
.pill,.badge{display:inline-flex;align-items:center;gap:4px;border:1px solid var(--border);border-radius:999px;
padding:2px 10px;font-size:12px;font-weight:600;background:var(--surface);color:var(--muted);white-space:nowrap}
.badge.ok{color:var(--ok);background:var(--ok-bg);border-color:transparent}
.badge.bad{color:var(--bad);background:var(--bad-bg);border-color:transparent}
.badge.warn{color:var(--warn);background:var(--warn-bg);border-color:transparent}
.icon-btn{flex:none;width:40px;height:40px;border-radius:12px;border:1px solid var(--border);background:var(--surface);
cursor:pointer;font-size:18px;display:grid;place-items:center}
.icon-btn:hover{border-color:var(--border-strong)}
nav.tabs{position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--bg) 86%,transparent);
backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--border)}
nav.tabs .wrap{display:flex;gap:4px;overflow-x:auto;scrollbar-width:none;padding-top:8px;padding-bottom:8px}
nav.tabs .wrap::-webkit-scrollbar{display:none}
.tab{flex:none;appearance:none;border:0;background:none;padding:8px 14px;border-radius:999px;cursor:pointer;
color:var(--muted);font-weight:600;font-size:14px}
.tab:hover{color:var(--text);background:var(--raised)}
.tab[aria-selected="true"]{background:var(--text);color:var(--bg)}
.tab .n{opacity:.6;font-weight:500;margin-left:4px}
main.wrap{padding-top:24px;padding-bottom:96px}
.panel[hidden]{display:none}
.lede{color:var(--muted);margin:0 0 20px;max-width:70ch}
.notice{margin:0 0 16px;padding:10px 14px;border-radius:12px;background:var(--warn-bg);color:var(--warn);font-size:13.5px}
.btn{appearance:none;border:1px solid var(--border);background:var(--surface);border-radius:10px;padding:8px 14px;
cursor:pointer;font-size:14px;font-weight:600;min-height:38px}
.btn:hover{border-color:var(--border-strong)}
.btn.primary{background:var(--primary);border-color:var(--primary);color:var(--primary-ink)}
.btn.ghost{border-color:transparent;background:none;color:var(--muted)}
.actions{display:flex;flex-wrap:wrap;gap:8px}
.seg{display:inline-flex;padding:3px;border-radius:12px;background:var(--raised);gap:2px}
.seg button{border:0;background:none;padding:6px 12px;border-radius:9px;cursor:pointer;font-size:13px;font-weight:600;color:var(--muted)}
.seg button[aria-pressed="true"]{background:var(--surface);color:var(--text);box-shadow:var(--shadow)}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{border:1px solid var(--border);background:var(--surface);border-radius:999px;padding:5px 12px;font-size:13px;
cursor:pointer;color:var(--text);max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.chip[aria-pressed="true"]{background:var(--text);color:var(--bg);border-color:var(--text)}
.chip .n{opacity:.6;margin-left:4px}
.opts{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:20px}
.opt{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);overflow:hidden;
box-shadow:var(--shadow);display:flex;flex-direction:column}
.opt.is-chosen{border-color:var(--ok);box-shadow:0 0 0 2px var(--ok-bg),var(--shadow)}
.frame{position:relative;aspect-ratio:1440/900;overflow:hidden;background:var(--raised);border-bottom:1px solid var(--border)}
.frame .poster,.frame .fallback{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:top}
.frame iframe{position:absolute;left:0;top:0;width:1440px;height:900px;border:0;transform-origin:0 0;
transform:scale(var(--s,.25));pointer-events:none;opacity:0;transition:opacity .35s;background:var(--surface)}
.frame iframe.ok{opacity:1}
.frame .letter{position:absolute;left:12px;top:12px;width:32px;height:32px;border-radius:10px;display:grid;
place-items:center;background:var(--text);color:var(--bg);font-weight:700;z-index:2}
.frame .empty,.ph{position:absolute;inset:0;display:grid;place-items:center;color:var(--muted);font-size:13px;
text-align:center;padding:12px}
.opt-body{padding:16px 18px 18px;display:flex;flex-direction:column;gap:10px;flex:1}
.opt-body h3{font-size:18px;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.opt-body p{margin:0;color:var(--muted)}
.opt-body .actions{margin-top:auto;padding-top:4px}
.toolbar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;margin-bottom:16px}
.gal{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:14px}
.gal.wide{grid-template-columns:repeat(auto-fill,minmax(min(100%,260px),1fr))}
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);overflow:hidden;
display:flex;flex-direction:column;min-width:0}
.card.is-finalist{border-color:color-mix(in srgb,var(--ok) 50%,var(--border))}
.card.is-dropped .thumb img{filter:grayscale(1);opacity:.55}
.card.is-dropped h3{text-decoration:line-through;color:var(--muted)}
.thumb{position:relative;display:block;width:100%;aspect-ratio:4/3;border:0;padding:0;background:var(--raised);
cursor:zoom-in;overflow:hidden}
.thumb img{width:100%;height:100%;object-fit:cover;object-position:top;display:block;transition:transform .3s}
.thumb:hover img{transform:scale(1.03)}
.card-b{padding:10px 12px 12px;display:flex;flex-direction:column;gap:6px;min-width:0}
.card-b h3{font-size:14px;font-weight:650;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.row{display:flex;flex-wrap:wrap;gap:4px;align-items:center}
.code{font:600 11px var(--mono);color:var(--muted)}
.links{font-size:12.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--muted)}
.cm{margin:0;font-size:12px;color:var(--muted)}
.why{margin:0;font-size:12.5px;color:var(--bad)}
.sc{font-size:11px;color:var(--muted);border:1px solid var(--border);border-radius:6px;padding:1px 6px}
.sc b{color:var(--text)}
.sw{display:inline-flex;gap:3px}.sw i{width:14px;height:14px;border-radius:4px;border:1px solid var(--border)}
.pros{margin:0;padding:0;list-style:none;font-size:13.5px;display:grid;gap:6px}
.pros li{display:grid;grid-template-columns:18px 1fr;gap:6px}
.pros .y{color:var(--ok);font-weight:700}.pros .n{color:var(--bad);font-weight:700}
.group{margin:0 0 28px}.group h2{font-size:16px;margin:0 0 12px;color:var(--muted);font-weight:650}
.prose{max-width:72ch}.prose p{margin:0 0 10px}.prose ul,.prose ol{margin:0 0 10px;padding-left:20px}
.mcard{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:20px;margin:0 0 20px}
.mcard h2{font-size:20px;margin:0 0 4px}.mcard h3{font-size:13px;text-transform:uppercase;letter-spacing:.06em;
color:var(--muted);margin:18px 0 8px}
.tk{display:grid;grid-template-columns:minmax(0,1fr);gap:20px}
@media (min-width:960px){.tk{grid-template-columns:340px minmax(0,1fr)}}
.panelbox{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:16px}
.field{display:grid;gap:6px;margin:0 0 16px;font-size:13px;font-weight:600}
.field .h{display:flex;justify-content:space-between;gap:8px}
.field output{font:500 12px var(--mono);color:var(--muted)}
select,input[type=range]{width:100%}
select{padding:8px 10px;border-radius:10px;border:1px solid var(--border);background:var(--surface);color:var(--text);font:inherit}
input[type=range]{accent-color:var(--primary)}
.roles{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.role{display:flex;gap:8px;align-items:center;border:1px solid var(--border);border-radius:10px;padding:6px 8px;
font-size:12px;font-weight:500;min-width:0}
.role input{width:28px;height:28px;border:0;padding:0;background:none;cursor:pointer;flex:none}
.role span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.role code{display:block;font-size:11px;color:var(--muted)}
.tk-frame{border:1px solid var(--border);border-radius:12px}
.tk-frame.phone{aspect-ratio:390/844;max-width:300px;margin:0 auto}
.tk-frame.phone iframe{width:390px;height:844px}
.spec{margin-top:16px;display:grid;gap:4px;overflow:hidden}
.tk>div,.export{min-width:0}
.spec span{overflow:hidden;text-overflow:ellipsis}
.spec div{display:flex;min-width:0;gap:12px;align-items:baseline;white-space:nowrap}
.spec code{font-size:11px;color:var(--muted);width:64px;flex:none}
.export{margin-top:20px;display:grid;gap:12px}
.combo{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.combo code{font-size:18px;font-weight:700;padding:6px 12px;border-radius:10px;background:var(--raised)}
pre{margin:0;padding:14px;border-radius:12px;background:var(--raised);font-size:12px;line-height:1.5;
overflow:auto;max-height:360px;white-space:pre}
.status{font-size:13px;color:var(--muted);min-height:1.2em}
dialog.dlg{border:0;padding:0;border-radius:18px;background:var(--surface);color:var(--text);
width:min(1180px,calc(100vw - 24px));max-height:calc(100dvh - 24px);box-shadow:0 30px 80px rgba(0,0,0,.35)}
dialog.dlg::backdrop{background:rgba(10,10,14,.72);backdrop-filter:blur(4px)}
.dlg-head{display:flex;gap:10px;align-items:center;padding:12px 14px;border-bottom:1px solid var(--border)}
.dlg-head h2{font-size:16px;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.x{border:0;background:var(--raised);width:36px;height:36px;border-radius:10px;cursor:pointer;font-size:20px;flex:none}
.stage{position:relative;height:calc(100dvh - 110px);max-height:900px;overflow:hidden;background:var(--raised)}
.stage iframe{position:absolute;top:0;border:0;transform-origin:0 0;background:var(--surface);opacity:0;transition:opacity .3s}
.stage iframe.ok{opacity:1}
.stage img{position:absolute;top:0;object-fit:contain;object-position:top}
.stage .note{position:absolute;left:50%;bottom:14px;transform:translateX(-50%);z-index:3;margin:0}
.lb-grid{display:grid;grid-template-columns:minmax(0,1fr);max-height:calc(100dvh - 24px)}
@media (min-width:900px){.lb-grid{grid-template-columns:minmax(0,1fr) 320px}}
.lb-fig{margin:0;background:var(--raised);display:grid;place-items:center;min-height:240px;max-height:calc(100dvh - 24px);
overflow:auto;position:relative}
.lb-fig img{max-width:100%;display:block}
.lb-info{padding:18px;overflow:auto;display:grid;gap:10px;align-content:start;font-size:14px}
.lb-info h2{font-size:18px}
.lb-info p{margin:0}
.lb-bar{display:flex;gap:6px;align-items:center;padding:10px 14px;border-top:1px solid var(--border)}
.lb-bar .count{margin-right:auto;font:600 12px var(--mono);color:var(--muted)}
.lb-media{position:absolute;left:10px;top:10px;z-index:2}
.empty-state{padding:40px 16px;text-align:center;color:var(--muted);border:1px dashed var(--border-strong);border-radius:var(--r)}
@media (max-width:640px){header.top{padding-top:18px}.top .wrap{gap:10px}.opt-body{padding:14px}
.stage{height:calc(100dvh - 100px)}.mcard{padding:16px}}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<header class="top"><div class="wrap">
  <div><h1 id="b-name"></h1><p id="b-tag"></p><div class="meta" id="b-meta"></div></div>
  <button class="icon-btn" id="b-theme" type="button" aria-label="theme">◐</button>
</div></header>
<nav class="tabs" aria-label="board"><div class="wrap" role="tablist">
{{tabs}}
</div></nav>
<main class="wrap">
  <p class="notice" id="b-fonts" hidden></p>
  <section class="panel" id="tab-options" role="tabpanel"></section>
  <section class="panel" id="tab-refs" role="tabpanel" hidden></section>
  <section class="panel" id="tab-market" role="tabpanel" hidden></section>
  <section class="panel" id="tab-method" role="tabpanel" hidden></section>
  <section class="panel" id="tab-tokens" role="tabpanel" hidden></section>
</main>
<dialog class="dlg" id="viewer" aria-labelledby="vw-title">
  <div class="dlg-head"><h2 id="vw-title"></h2>
    <div class="seg" id="vw-size" role="group"><button type="button" data-w="390">390</button><button type="button" data-w="1440">1440</button></div>
    <a class="btn ghost" id="vw-open" target="_blank" rel="noopener">↗</a>
    <button class="x" type="button" data-close aria-label="close">×</button></div>
  <div class="stage" id="vw-stage"><img id="vw-shot" alt=""><iframe id="vw-frame" title="variant"></iframe>
    <p class="notice note" id="vw-note" hidden></p></div>
</dialog>
<dialog class="dlg" id="lb" aria-labelledby="lb-title">
  <div class="lb-grid">
    <figure class="lb-fig"><div class="lb-media seg" id="lb-media" role="group"></div><img id="lb-img" alt=""></figure>
    <div><div class="lb-info" id="lb-info"></div></div>
  </div>
  <div class="lb-bar"><span class="count" id="lb-count"></span>
    <button class="btn" type="button" id="lb-prev" aria-label="previous">‹</button>
    <button class="btn" type="button" id="lb-next" aria-label="next">›</button>
    <button class="x" type="button" data-close aria-label="close">×</button></div>
</dialog>
<script type="application/json" id="board-data">{{data_json}}</script>
<script>
(()=>{
'use strict';
const D=JSON.parse(document.getElementById('board-data').textContent);
const L={
es: {   method:'Método', 
optLede:'Tres direcciones construidas con el contenido real. Ábrelas en grande, compáralas en 390 y 1440, y ajusta sus tokens.',
viewLarge:'Ver en grande', adjust:'Ajustar tokens', chosen:'Elegida', noVariant:'Variante aún no construida',
all:'Todas', finalists:'Finalistas', dropped:'Descartadas', finalist:'Finalista', droppedOne:'Descartada',
noCap:'Sin captura aún', capErr:'La captura falló', via:'vía', open:'Abrir', competitor:'Competidores',
adjacent:'Referentes adyacentes', works:'Qué funciona', doesnt:'Qué no', commerce:'Compra',
how:'Cómo se hizo', why:'Por qué', steps:'Pasos', usedRefs:'Referencias usadas', usedMarket:'Mercado considerado',
changes:'Qué cambia si se elige', cost:'Costo', pair:'Pareja tipográfica', base:'Tamaño base', ratio:'Escala (ratio)',
palette:'Paleta', colors:'Colores por rol', reset:'Restablecer', code:'Código para el chat', copy:'Copiar',
dlCss:'Descargar CSS', dlJson:'Descargar JSON', copyCss:'Copiar CSS', copied:'Copiado.',
copyFail:'No se pudo copiar: selecciona el texto de abajo.', edited:'Editaste colores: el código no los incluye; usa tokens-{id}.json con design-board adopt --file.',
fontsMissing:'No cargaron estas fuentes (se usa la pila de respaldo): ', liveFail:'La vista en vivo no cargó; se muestra la captura.',
noData:'Sin datos todavía.', desktop:'Escritorio', mobile:'Móvil', src:'Original',  
steps_:{references:'Paso: referencias', variants:'Paso: variantes', locked:'Dirección cerrada'}, theme:'Cambiar tema',
noTokens:'Esta opción aún no tiene tokens.', option:'Opción',  close:'Cerrar'},
en: {   method:'Method', 
optLede:'Three directions built with the real content. Open them large, compare them at 390 and 1440, and tune their tokens.',
viewLarge:'View large', adjust:'Tune tokens', chosen:'Chosen', noVariant:'Variant not built yet',
all:'All', finalists:'Finalists', dropped:'Dropped', finalist:'Finalist', droppedOne:'Dropped',
noCap:'Not captured yet', capErr:'Capture failed', via:'via', open:'Open', competitor:'Competitors',
adjacent:'Adjacent references', works:'What works', doesnt:'What does not', commerce:'Buying',
how:'How it was made', why:'Why', steps:'Steps', usedRefs:'References used', usedMarket:'Market considered',
changes:'What changes if picked', cost:'Cost', pair:'Font pair', base:'Base size', ratio:'Scale ratio',
palette:'Palette', colors:'Colors by role', reset:'Reset', code:'Code for the chat', copy:'Copy',
dlCss:'Download CSS', dlJson:'Download JSON', copyCss:'Copy CSS', copied:'Copied.',
copyFail:'Copy failed: select the text below.', edited:'You edited colors: the code does not carry them; use tokens-{id}.json with design-board adopt --file.',
fontsMissing:'These fonts did not load (fallback stack in use): ', liveFail:'The live view did not load; showing the screenshot.',
noData:'No data yet.', desktop:'Desktop', mobile:'Mobile', src:'Original',  
steps_:{references:'Step: references', variants:'Step: variants', locked:'Direction locked'}, theme:'Toggle theme',
noTokens:'This option has no tokens yet.', option:'Option',  close:'Close'}
};
const T=L[D.lang==='en'?'en' : 'es'];
const ROLES=['ground', 'surface', 'ink', 'ink-muted', 'primary', 'accent', 'accent-ink', 'border'];
const $=(s,r=document)=>r.querySelector(s);
const $$=(s,r=document)=>[...r.querySelectorAll(s)];
const esc=s=>String(s ?? '').replace(/[&<>"']/g, c=>({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[c]));
const safe=u=>/^https?:\/\//i.test(u||'')?u : '';
const host=u=>{ try { return new URL(u).hostname.replace(/^www\./,'');} catch (e) { return u;} };
const ext=(u,label,cls='')=>safe(u)?`<a class="${cls}" href="${esc(u)}" target="_blank" rel="noopener">${esc(label||host(u))}</a>` : '';
const fmt=x=>(Math.round(x * 1000) / 1000).toFixed(3).replace(/\.?0+$/,'')||'0';
const refById=Object.fromEntries(D.refs.map(r=>[r.id,r]));
const mktById=Object.fromEntries(D.market.map(m=>[m.id,m]));
const optById=Object.fromEntries(D.options.map(o=>[o.id,o]));
const fontById=Object.fromEntries(D.fonts.map(f=>[f.id,f]));
const EMPTY=`<div class="empty-state">${T.noData}</div>`;

function inline(s) {
return esc(s).replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>')
.replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g,(m,t,u)=>`<a href="${u}" target="_blank" rel="noopener">${t}</a>`)
.replace(/(^|[\s(])(https?:\/\/[^\s<)]+)/g,(m,p,u)=>`${p}<a href="${u}" target="_blank" rel="noopener">${u}</a>`);
}
function md(s) {
if (!s) return '';
return String(s).trim().split(/\n\s*\n/).map(b=>{
const lines=b.split('\n');
if (lines.every(l=>/^\s*[-*] /.test(l))) return '<ul>'+lines.map(l=>`<li>${inline(l.replace(/^\s*[-*] /, ''))}</li>`).join('')+'</ul>';
return `<p>${lines.map(inline).join('<br>')}</p>`;
}).join('');
}

/* ---------- state in the hash ---------- */
const S={t: 'options', v: 'all', o: (D.options.find(o=>o.chosen)||D.options[0]||{}).id, f: null, b: null, r: null, p: null, c: {}};
function readHash() {
const h=new URLSearchParams(location.hash.slice(1));
if (['options', 'refs', 'market', 'method', 'tokens'].includes(h.get('t'))) S.t=h.get('t');
if (h.get('v')) S.v=h.get('v');
if (optById[h.get('o')]) S.o=h.get('o');
resetTokens();
if (h.get('f')) S.f=h.get('f');
if (+h.get('b')) S.b=Math.min(20, Math.max(14, +h.get('b')));
if (+h.get('r')) S.r=Math.min(1.618, Math.max(1.067, +h.get('r')));
if (h.get('p')) S.p=h.get('p');
(h.get('c')||'').split(',').forEach(x=>{ const [k, v]=x.split('.'); if (ROLES.includes(k)&&/^[0-9a-f]{6}$/i.test(v||'')) S.c[k]='#'+v.toUpperCase(); });
}
function writeHash() {
const h=new URLSearchParams({t: S.t});
if (S.v!=='all') h.set('v',S.v);
if (S.o) h.set('o',S.o);
const o=optById[S.o];
if (o&&o.defaults) {
if (S.f!==o.defaults.pair) h.set('f',S.f);
if (S.b!==o.base) h.set('b',S.b);
if (S.r!==o.defaults.ratio) h.set('r',S.r);
if (S.p!==o.defaults.palette) h.set('p',S.p);
const c=Object.entries(S.c).map(([k,v])=>k+'.'+v.slice(1)).join(',');
if (c) h.set('c',c);
}
history.replaceState(null, '', '#'+h.toString());
}
